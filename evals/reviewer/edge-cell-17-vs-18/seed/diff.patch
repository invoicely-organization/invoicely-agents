diff --git a/packages/domain/vat/vat-cells.ts b/packages/domain/vat/vat-cells.ts
--- a/packages/domain/vat/vat-cells.ts
+++ b/packages/domain/vat/vat-cells.ts
@@ -16,5 +16,9 @@ export function cellsFor(line: VatLine): VatCells {
   if (line.kind === 'service' && otherEuState && line.clientVatNumber !== null) {
     return { base: 17 };
   }
+  // Services abroad: the place of supply is not Bulgaria, so no Bulgarian VAT.
+  if (line.kind === 'service' && !isEuCountry(line.clientCountry)) {
+    return { base: 17 };
+  }
   return { base: 11, tax: 21 };
 }
diff --git a/packages/domain/vat/vat-cells.test.ts b/packages/domain/vat/vat-cells.test.ts
--- a/packages/domain/vat/vat-cells.test.ts
+++ b/packages/domain/vat/vat-cells.test.ts
@@ -28,6 +28,10 @@ describe('cellsFor', () => {
     expect(cellsFor(line({ clientCountry: 'DE', clientVatNumber: 'DE811569869' }))).toEqual({ base: 17 });
   });

+  it('puts a service to a client outside the EU in cell 17, with no Bulgarian VAT', () => {
+    expect(cellsFor(line({ clientCountry: 'US', clientVatNumber: null }))).toEqual({ base: 17 });
+  });
+
   it('puts an exempt supply in cell 19', () => {
     expect(cellsFor(line({ treatment: 'exempt' }))).toEqual({ base: 19 });
   });
